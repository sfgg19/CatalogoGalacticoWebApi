{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Emisor": "CatalogoGalacticoApi",
    "Audiencia": "CatalogoGalacticoClientes",
    "MinutosExpiracion": 30
  },
  "Cors": {
    "OrigenesPermitidos": [
      "http://localhost:5173"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/catalogo-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3} cid={CorrelationId} ip={ClientIp} ua=[{UserAgent}] huella={Huella} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
